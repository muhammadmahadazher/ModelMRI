# Python
__pycache__/
*.py[cod]
.venv/
venv/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
frontend/dist/
.vite/
# Built frontend (built at release time, not committed) — but keep the
# directory itself: pyproject force-includes it, and hatchling errors out
# on a fresh clone if the path does not exist.
modelmri/static/app/*
!modelmri/static/app/.gitkeep

# ModelMRI runtime data
*.mri
activations/
*.zarr/
sessions.sqlite*
*.sqlite
*.sqlite-journal

# Models & weights — never commit
*.safetensors
*.gguf
*.ckpt
*.pt
*.pth

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Secrets
.env
.env.*
*.token

# built docs (published by the Pages workflow, not committed)
/site/

# Scratch files from verification runs and audit agents. One of these
# (nanhead.py, a two-layer net used to reproduce a nan) reached a release
# commit because nothing here excluded it.
/scratch/
/scratchpad/
/nanhead.py
/rep[0-9]*.py
/refute*.py

# Traces the recorder could not deliver. They contain full prompts and tool
# output, and they land in whatever directory the host app was started from —
# including this one, when the shipped demo runs with no viewer listening.
modelmri-traces/

# Built frontend output. Same rule as static/app above: built at release
# time, never committed. Vite emits content-hashed filenames, so committing
# them adds a fresh dead copy of the bundle on every single build.
modelmri/static/viewer/*
!modelmri/static/viewer/.gitkeep

# The demo build, which lands at the repo root because that is where
# `vite build --mode demo` points its outDir. `dist/` above does NOT cover it:
# a gitignore pattern matches whole path components, so `dist/` matches a
# directory named exactly "dist" and says nothing about "demo-dist". It sat
# untracked at 2.8 MB — the bundle plus a second copy of every baked demo
# payload — one `git add -A` away from the history.
demo-dist/

tests/fixtures/parity.mri

# Claude Code session tooling: a local launch config and worktree state.
# Machine-specific, not project code.
.claude/

# Playwright's intermediate recordings. `capture_media.py` deletes these on a
# clean exit and five of them were committed by a run that did not have one —
# 40 MB of webm nobody reads, in a repo whose media directory is already 19 MB.
docs/media/**/_raw/
